---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Navbar } from "../../components/Navbar";
import { Footer } from "../../components/Footer";
import { Scroll } from "../../components/Stickers";
import { ChevronDown } from "lucide-react";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const categories = [
  "All",
  ...Array.from(new Set(posts.map((p) => p.data.category))).sort(),
];
---

<Layout title="Writings | Sujal Jariwala">
  <div class="flex justify-center">
    <main class="noise min-h-screen w-full max-w-3xl border-x border-line bg-panel transition-colors duration-[400ms]">
      <Navbar client:load />

      <div class="hatch" aria-hidden="true"></div>
      <div class="flex min-h-16 items-center justify-between gap-3 border-b border-line bg-band px-[18px] py-2 sm:px-6">
        <h1 class="m-0 text-[32px] leading-none font-normal italic tracking-tight">
          Writings
        </h1>
        <Scroll className="-my-2.5" style={{ "--w": "62px", "--r": "-5deg" }} />
      </div>

      <div class="flex flex-col gap-4 p-[18px] sm:p-6">
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 px-3.5">
          <p class="m-0 max-w-[40ch] text-mute">
            Engineering reflections, system design choices, and personal essays.
          </p>

          <div class="relative flex-none">
            <select
              id="category-filter"
              aria-label="Filter by topic"
              class="cursor-pointer appearance-none rounded-full border border-line-strong bg-transparent py-1.5 pr-9 pl-4 text-[14px] text-ink transition-colors hover:bg-band [&>option]:bg-panel [&>option]:text-ink"
            >
              {categories.map((cat) => (
                <option value={cat}>
                  {cat === "All" ? "All topics" : cat}
                </option>
              ))}
            </select>
            <ChevronDown
              size={14}
              aria-hidden="true"
              className="pointer-events-none absolute top-1/2 right-3.5 -translate-y-1/2 text-mute"
            />
          </div>
        </div>

        <div class="flex flex-col border-t border-line">
          {posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              data-category={post.data.category}
              class="blog-row flex flex-col gap-1 border-b border-line px-3.5 py-4 no-underline transition-colors hover:bg-band"
            >
              <span class="truncate text-[clamp(17px,2.2vw,19px)] leading-[1.3] font-semibold tracking-[-0.01em]">
                {post.data.title}
              </span>
              <span class="text-[13.5px] text-mute">
                {post.data.category} ·{" "}
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
              </span>
            </a>
          ))}

          <p id="no-posts" hidden class="m-0 py-8 text-center text-mute">
            No articles in this category.
          </p>
        </div>
      </div>

      <Footer />
    </main>
  </div>
</Layout>

<script>
  function initCategoryFilter() {
    const select = document.getElementById(
      "category-filter",
    ) as HTMLSelectElement | null;
    const rows = document.querySelectorAll<HTMLElement>(".blog-row");
    const noPosts = document.getElementById("no-posts");

    if (!select || !rows.length) return;

    function applyFilter(category: string) {
      let visible = 0;

      rows.forEach((row) => {
        const show = category === "All" || row.dataset.category === category;
        row.hidden = !show;
        if (show) visible++;
      });

      if (noPosts) noPosts.hidden = visible !== 0;
    }

    select.addEventListener("change", () => {
      const category = select.value;
      applyFilter(category);

      const url = new URL(window.location.href);
      if (category === "All") url.searchParams.delete("category");
      else url.searchParams.set("category", category);
      window.history.replaceState({}, "", url.toString());
    });

    const initial = new URLSearchParams(window.location.search).get("category");
    if (initial && [...select.options].some((o) => o.value === initial)) {
      select.value = initial;
      applyFilter(initial);
    }
  }

  initCategoryFilter();
  document.addEventListener("astro:page-load", initCategoryFilter);
</script>
