---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { Navbar } from "../../components/Navbar";
import { Footer } from "../../components/Footer";
import { ArrowRight, ArrowLeft, Calendar, Clock } from "lucide-react";

const posts = (
  await getCollection("blog", ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [
  "All",
  ...Array.from(new Set(posts.map((p) => p.data.category))).sort(),
];
---

<Layout title="Blog | Sujal Jariwala">
  <main class="min-h-screen relative overflow-hidden bg-bg-outer text-gray-light">
    {/* Global background circles */}
    <div
      class="absolute -top-125 -right-125 w-300 h-300 border border-circle rounded-full pointer-events-none z-0"
    >
    </div>
    <div
      class="absolute top-[20%] -left-150 w-250 h-250 border border-circle rounded-full pointer-events-none z-0"
    >
    </div>

    {/* Outer Breadcrumb / Status Section */}
    <div class="max-w-7xl mx-auto px-6 py-12 md:py-16 relative z-10">
      <div
        class="flex flex-col md:flex-row justify-between items-start text-sm text-gray-light"
      >
        <div class="mb-4 md:mb-0">
          <a
            href="/"
            class="font-display tracking-wider hover:text-white transition-colors flex items-center gap-2 group"
          >
            <ArrowLeft size={14} className="group-hover:-translate-x-1 transition-transform" />
            <span>... /Home / Blog ...</span>
          </a>
        </div>
        <div class="md:max-w-md">
          <p class="italic leading-relaxed text-xs md:text-sm">
            Technical writing, architectural decision records, and essays on software engineering, product design, and life.
          </p>
        </div>
      </div>
    </div>

    {/* Main Portfolio Container */}
    <div class="max-w-300 mx-auto px-4 md:px-6 mb-32 relative z-10">
      <div
        class="bg-bg-inner border border-border-subtle rounded-4xl overflow-hidden shadow-2xl relative"
      >
        <!-- <DecorativeCircle size="800px" top="-400px" right="-200px" />
        <DecorativeCircle size="600px" bottom="10%" left="-300px" />
        <DecorativeCircle size="1000px" top="40%" right="-500px" /> -->

        <Navbar client:load />

        {/* Blog Header */}
        <section class="py-16 md:py-24 px-6 md:px-12 border-b border-border-subtle relative z-10">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
            <div class="max-w-2xl">
              <p class="font-display text-sm tracking-wider text-gray-light mb-4">
                ... /Writing ...
              </p>
              <h1 class="text-5xl sm:text-7xl md:text-8xl lg:text-[7rem] font-display text-white leading-tight tracking-tight">
                Blog
              </h1>
            </div>
            <div class="md:max-w-sm">
              <p class="text-gray-light text-sm italic leading-relaxed">
                A collection of engineering reflections, system design choices, and personal essays.
              </p>
            </div>
          </div>
        </section>

        {/* Category Filter Buttons */}
        <section class="pt-8 sm:pt-12 px-4 sm:px-6 md:px-12 relative z-10">
          <div class="flex items-center gap-2.5 overflow-x-auto pb-2 scrollbar-hide text-xs font-display">
            {categories.map((cat, idx) => (
              <button
                type="button"
                data-filter={cat}
                class={`category-filter-btn px-4 py-2 rounded-full transition-all duration-300 whitespace-nowrap cursor-pointer flex items-center gap-1.5 ${
                  idx === 0
                    ? "bg-white text-bg-inner font-medium shadow-md"
                    : "border border-border-subtle text-gray-light hover:border-white hover:text-white bg-white/[0.02]"
                }`}
              >
                <span>{cat}</span>
                <span class="text-[10px] opacity-60">
                  {cat === "All" ? posts.length : posts.filter((p) => p.data.category === cat).length}
                </span>
              </button>
            ))}
          </div>
        </section>

        {/* Blog Posts: Grid container, and inside each blog is a Flex box */}
        <section class="py-8 md:py-16 px-4 sm:px-6 md:px-12 relative z-10">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {posts.map((post) => (
              <a
                href={`/blog/${post.id}`}
                data-category={post.data.category}
                class="blog-card border border-border-subtle rounded-3xl sm:rounded-4xl p-5 sm:p-7 hover:border-white hover:-translate-y-1.5 hover:bg-white/[0.02] hover:shadow-2xl transition-all duration-500 group flex flex-col justify-between cursor-pointer"
              >
                <div>
                  {/* Unique SVG Header Banner */}
                  <div class="flex items-center justify-between gap-2 mb-3.5 text-xs font-display flex-wrap sm:flex-nowrap">
                    <span class="border border-border-subtle rounded-full px-3 py-1 text-white bg-white/5 text-[11px] uppercase tracking-wider group-hover:border-white/40 transition-colors whitespace-nowrap">
                      {post.data.category}
                    </span>
                    <span class="flex items-center gap-1 text-gray-light text-[11px] whitespace-nowrap">
                      <Clock size={12} />
                      {post.data.readTime}
                    </span>
                  </div>

                  <h2 class="font-display text-white text-lg sm:text-xl md:text-2xl mb-3 leading-snug group-hover:text-blue-400 transition-colors">
                    {post.data.title}
                  </h2>

                  {/* <p class="text-gray-light text-xs sm:text-sm italic line-clamp-2 leading-relaxed">
                    {post.data.description}
                  </p> */}
                </div>

                <div class="flex items-center justify-between gap-2 sm:gap-4 mt-6 pt-5 border-t border-border-subtle/50">
                  <div class="flex items-center gap-1.5 text-[11px] sm:text-xs font-display text-gray-medium shrink-0 whitespace-nowrap">
                    <Calendar size={13} />
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString("en-US", {
                        year: "numeric",
                        month: "short",
                        day: "numeric",
                      })}
                    </time>
                  </div>

                  <div class="flex items-center gap-2 sm:gap-3 shrink-0">
                    <span class="bg-white text-bg-inner font-medium text-xs sm:text-sm px-4 sm:px-5 py-1.5 rounded-full whitespace-nowrap group-hover:bg-gray-200 group-hover:scale-105 transition-all duration-300">
                      Read post
                    </span>
                    <span class="w-8 h-8 sm:w-9 sm:h-9 rounded-full border border-border-subtle flex items-center justify-center shrink-0 group-hover:border-white group-hover:bg-white group-hover:text-bg-inner transition-colors duration-500">
                      <ArrowRight size={14} className="transition-transform duration-500 group-hover:translate-x-0.5" />
                    </span>
                  </div>
                </div>
              </a>
            ))}

            {/* No posts message */}
            <div id="no-posts" class="hidden col-span-full py-16 text-center border border-border-subtle rounded-3xl bg-bg-inner/20">
              <p class="font-display text-white text-base mb-1">No articles found in this category.</p>
              <p class="text-gray-light text-xs italic">Please select another category or "All".</p>
            </div>
          </div>
        </section>

        <Footer />
      </div>
    </div>
  </main>
</Layout>

<script>
  function initCategoryFilter() {
    const filterButtons = document.querySelectorAll<HTMLButtonElement>(".category-filter-btn");
    const blogCards = document.querySelectorAll<HTMLElement>(".blog-card");
    const noPosts = document.getElementById("no-posts");

    if (!filterButtons.length || !blogCards.length) return;

    function applyFilter(category: string) {
      let visibleCount = 0;

      filterButtons.forEach((btn) => {
        const filter = btn.getAttribute("data-filter");
        if (filter === category) {
          btn.className = "category-filter-btn px-4 py-2 rounded-full transition-all duration-300 whitespace-nowrap cursor-pointer flex items-center gap-1.5 bg-white text-bg-inner font-medium shadow-md";
        } else {
          btn.className = "category-filter-btn px-4 py-2 rounded-full transition-all duration-300 whitespace-nowrap cursor-pointer flex items-center gap-1.5 border border-border-subtle text-gray-light hover:border-white hover:text-white bg-white/[0.02]";
        }
      });

      blogCards.forEach((card) => {
        const cardCategory = card.getAttribute("data-category");
        if (category === "All" || cardCategory === category) {
          card.style.display = "flex";
          visibleCount++;
        } else {
          card.style.display = "none";
        }
      });

      if (noPosts) {
        noPosts.style.display = visibleCount === 0 ? "block" : "none";
      }
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const category = btn.getAttribute("data-filter") || "All";
        applyFilter(category);

        const url = new URL(window.location.href);
        if (category === "All") {
          url.searchParams.delete("category");
        } else {
          url.searchParams.set("category", category);
        }
        window.history.replaceState({}, "", url.toString());
      });
    });

    const params = new URLSearchParams(window.location.search);
    const initialCategory = params.get("category");
    if (initialCategory) {
      applyFilter(initialCategory);
    }
  }

  initCategoryFilter();
  document.addEventListener("astro:page-load", initCategoryFilter);
</script>
