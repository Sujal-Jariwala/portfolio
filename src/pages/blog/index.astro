---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { Navbar } from "../../components/Navbar";
import { Footer } from "../../components/Footer";
import { Scroll } from "../../components/Stickers";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// One branch per category, ordered by whichever has the newest post.
const branches: [string, typeof posts][] = [];
for (const p of posts) {
  const hit = branches.find(([c]) => c === p.data.category);
  if (hit) hit[1].push(p);
  else branches.push([p.data.category, [p]]);
}

const rail = "absolute -translate-x-1/2 border-l-[1.5px] border-line-strong";
---

<Layout title="Blog | Sujal Jariwala">
  <div class="flex justify-center">
    <main class="noise min-h-screen w-full max-w-3xl border-x border-line bg-panel transition-colors duration-[400ms]">
      <Navbar client:load />

      <div class="hatch" aria-hidden="true"></div>
      <div class="flex min-h-16 items-center justify-between gap-3 border-b border-line bg-band px-[18px] py-2 sm:px-6">
        <h1 class="m-0 text-[32px] leading-none font-normal italic tracking-[-0.025em]">
          Writings
        </h1>
        <Scroll className="-my-2.5" style={{ "--w": "62px", "--r": "-5deg" }} />
      </div>

      <div class="flex flex-col gap-5 p-[18px] sm:p-6">
        <p class="m-0 max-w-[60ch] text-mute">
          Engineering reflections, system design choices, and personal essays.
          Pick a branch.
        </p>

        {posts.length === 0 ? (
          <p class="m-0 py-8 text-center text-mute">No articles yet.</p>
        ) : (
          <div class="flex flex-col">
            {/* Root of the tree */}
            <div class="relative flex h-8 items-center pl-14">
              <span
                class={`${rail} left-[12px] top-1/2 bottom-0`}
                aria-hidden="true"
              ></span>
              <span
                class="absolute top-1/2 left-[12px] size-3 -translate-x-1/2 -translate-y-1/2 rounded-full bg-ink"
                aria-hidden="true"
              ></span>
              <span class="text-[13.5px] text-mute">
                All posts · {posts.length}
              </span>
            </div>

            {branches.map(([category, items], i) => {
              const lastBranch = i === branches.length - 1;
              return (
                <details
                  name="branch"
                  open={i === 0}
                  class="branch group relative"
                >
                  <summary class="flex h-11 cursor-pointer list-none items-center gap-2 rounded-lg pr-3 transition-colors hover:bg-band [&::-webkit-details-marker]:hidden">
                    {/* Trunk segment for this row, kept in the summary so it shows when closed.
                        It is positioned against the <details>, and stops where the last branch leaves it. */}
                    <span
                      class={`${rail} left-[12px] top-0 ${lastBranch ? "h-1" : "h-full"}`}
                      aria-hidden="true"
                    ></span>
                    <svg
                      viewBox="0 0 48 44"
                      aria-hidden="true"
                      focusable="false"
                      class="block h-11 w-12 flex-none overflow-visible"
                    >
                      <g fill="none" stroke-width="1.5" stroke-linecap="round">
                        <path
                          d="M12 4C12 16 18 22 36 22"
                          class="stroke-line-strong"
                        />
                        <path
                          d="M36 22V44"
                          class="stroke-line-strong opacity-0 group-open:opacity-100"
                        />
                        <circle
                          cx="36"
                          cy="22"
                          r="4.5"
                          class="fill-panel stroke-ink transition-colors group-open:fill-acc"
                        />
                      </g>
                    </svg>
                    <span class="text-[16px] font-semibold">{category}</span>
                    <span class="text-[13.5px] text-mute">{items.length}</span>
                    <svg
                      viewBox="0 0 16 16"
                      aria-hidden="true"
                      focusable="false"
                      class="ml-auto size-3.5 flex-none text-mute transition-transform duration-300 group-open:rotate-180"
                    >
                      <path
                        d="M3.5 6l4.5 4.5L12.5 6"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </summary>

                  <ul class="m-0 flex list-none flex-col p-0">
                    {items.map((post, j) => (
                      <li class="relative">
                        <span
                          class={`${rail} left-[36px] top-0 ${j === items.length - 1 ? "h-1/2" : "h-full"}`}
                          aria-hidden="true"
                        ></span>
                        <span
                          class="absolute top-1/2 left-[36px] size-[7px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-ink"
                          aria-hidden="true"
                        ></span>
                        <a
                          href={`/blog/${post.id}`}
                          class="flex items-baseline justify-between gap-4 rounded-lg py-2.5 pr-3 pl-14 no-underline transition-colors hover:bg-band"
                        >
                          <span class="min-w-0 truncate text-[15.5px]">
                            {post.data.title}
                          </span>
                          <time
                            datetime={post.data.pubDate.toISOString()}
                            class="shrink-0 text-[13.5px] text-mute"
                          >
                            {post.data.pubDate.toLocaleDateString("en-US", {
                              year: "numeric",
                              month: "short",
                              day: "numeric",
                            })}
                          </time>
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              );
            })}
          </div>
        )}
      </div>

      <Footer />
    </main>
  </div>
</Layout>

<style>
  /* Smooth open/close where ::details-content is supported; elsewhere it just snaps */
  .branch {
    interpolate-size: allow-keywords;
  }
  .branch::details-content {
    block-size: 0;
    overflow-y: clip;
    transition:
      block-size 0.5s cubic-bezier(0.4, 0.1, 0.2, 1),
      content-visibility 0.5s allow-discrete;
  }
  .branch[open]::details-content {
    block-size: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .branch::details-content {
      transition: none;
    }
  }
</style>
