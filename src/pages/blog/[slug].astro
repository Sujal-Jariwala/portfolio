---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { Navbar } from "../../components/Navbar";
import { Footer } from "../../components/Footer";
import { Scroll } from "../../components/Stickers";
import { ArrowLeft, ArrowRight, ArrowUpRight } from "lucide-react";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Fetch other posts for recommendations at the bottom
const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const otherPosts = allPosts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const fmt = (d: Date, month: "short" | "long") =>
  d.toLocaleDateString("en-US", { year: "numeric", month, day: "numeric" });
---

<Layout title={`${post.data.title} | Sujal Jariwala`}>
  <div class="flex justify-center">
    <main class="noise min-h-screen w-full max-w-3xl border-x border-line bg-panel transition-colors duration-[400ms]">
      <Navbar client:load />

      <div class="hatch" aria-hidden="true"></div>
      <div class="flex min-h-16 items-center justify-between gap-3 border-b border-line bg-band px-[18px] py-2 sm:px-6">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 font-medium no-underline hover:underline hover:decoration-1 hover:underline-offset-[5px]"
        >
          <ArrowLeft size={14} aria-hidden="true" />
          <span>Writings</span>
        </a>
        <Scroll className="-my-2.5" style={{ "--w": "62px", "--r": "-5deg" }} />
      </div>

      <article class="flex flex-col gap-8 p-[18px] sm:p-6">
        <header class="flex flex-col gap-4">
          <div class="flex flex-wrap items-center gap-2.5 text-[13.5px] text-mute">
            <span class="inline-block rounded-[10px] border border-line-strong px-2.5 py-0.5 leading-normal">
              {post.data.category}
            </span>
            <time datetime={post.data.pubDate.toISOString()}>
              {fmt(post.data.pubDate, "long")}
            </time>
            <span>{post.data.readTime}</span>
          </div>

          <h1 class="m-0  text-[clamp(30px,5vw,42px)] leading-[1.1] font-normal tracking-[-0.025em] italic text-balance">
            {post.data.title}
          </h1>

          <p class="m-0 max-w-[60ch] text-[17.5px] text-mute text-pretty">
            {post.data.description}
          </p>

          {post.data.mediumUrl && (
            <a
              href={post.data.mediumUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 self-start text-[13.5px] underline decoration-line-strong underline-offset-4 hover:decoration-current"
            >
              <span>Originally on Medium</span>
              <ArrowUpRight size={13} aria-hidden="true" />
            </a>
          )}
        </header>

        {post.data.heroImage && (
          <Image
            src={post.data.heroImage}
            alt={post.data.title}
            width={1200}
            height={630}
            class="h-auto max-h-[500px] w-full rounded-xl border border-line object-cover"
          />
        )}

        <div class="post-markdown-content">
          <Content />
        </div>
      </article>

      {otherPosts.length > 0 && (
        <section>
          <div class="hatch" aria-hidden="true"></div>
          <div class="flex min-h-16 items-center justify-between gap-3 border-b border-line bg-band px-[18px] py-2 sm:px-6">
            <h2 class="m-0  text-[32px] leading-none font-normal tracking-[-0.025em] italic">
              More writing
            </h2>
            <a
              href="/blog"
              class="inline-flex items-center gap-1.5 text-[13.5px] no-underline hover:underline hover:decoration-1 hover:underline-offset-[5px]"
            >
              <span>View all</span>
              <ArrowRight size={13} aria-hidden="true" />
            </a>
          </div>

          <div class="flex flex-col gap-1 p-[18px] sm:p-6">
            {otherPosts.map((other) => (
              <a
                href={`/blog/${other.id}`}
                class="block rounded-xl px-3.5 py-3 no-underline transition-colors hover:bg-band"
              >
                <span
                  title={other.data.title}
                  class="block truncate  text-[clamp(21px,2.6vw,24px)] leading-[1.2] font-normal tracking-[-0.015em] italic"
                >
                  {other.data.title}
                </span>
                <span class="mt-1.5 flex items-center gap-2.5 text-[13.5px] text-mute">
                  <span class="inline-block rounded-[10px] border border-line-strong px-2.5 py-0.5 leading-normal">
                    {other.data.category}
                  </span>
                  <time datetime={other.data.pubDate.toISOString()}>
                    {fmt(other.data.pubDate, "short")}
                  </time>
                </span>
              </a>
            ))}
          </div>
        </section>
      )}

      <Footer />
    </main>
  </div>
</Layout>

<style is:global>
  /* Markdown content styling for blog posts, driven by the theme tokens */
  .post-markdown-content {
    color: var(--ink);
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .post-markdown-content > * + * {
    margin-top: 1.5rem;
  }

  .post-markdown-content h1,
  .post-markdown-content h2,
  .post-markdown-content h3,
  .post-markdown-content h4 {
    font-style: italic;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .post-markdown-content h2 {
    font-size: 1.85rem;
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }

  .post-markdown-content h3 {
    font-size: 1.4rem;
    margin-top: 2.25rem;
  }

  .post-markdown-content strong {
    font-weight: 700;
  }

  .post-markdown-content a {
    text-decoration: underline;
    text-decoration-color: var(--line2);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.2s;
  }

  .post-markdown-content a:hover {
    text-decoration-color: currentColor;
  }

  .post-markdown-content ul {
    list-style-type: disc;
    padding-left: 1.5rem;
  }

  .post-markdown-content ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
  }

  .post-markdown-content li + li {
    margin-top: 0.5rem;
  }

  .post-markdown-content li::marker {
    color: var(--mute);
  }

  .post-markdown-content blockquote {
    margin-left: 0;
    padding: 0.75rem 1.25rem;
    border-left: 3px solid var(--acc);
    border-radius: 0 12px 12px 0;
    background: var(--band);
    font-style: italic;
  }

  .post-markdown-content code:not(pre code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.875em;
    padding: 0.15em 0.4em;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--band);
  }

  .post-markdown-content pre {
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--line);
    background-color: #0f181c !important;
    overflow-x: auto;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .post-markdown-content pre code {
    padding: 0;
    border: none;
    background: transparent;
    font-size: inherit;
    color: inherit;
  }

  .post-markdown-content hr {
    border: none;
    border-top: 1px solid var(--line);
    margin: 3rem 0;
  }
</style>
