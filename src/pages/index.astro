---
import { getImage } from "astro:assets";
import portraitImg from "../assets/portrait.jpeg";

const optimizedPortrait = await getImage({
  src: portraitImg,
  width: 800,
  format: "webp",
});

import previewImg from "../assets/resuvo_homepage.png";
import editorImg from "../assets/resume_editor.png";

const optimizedPreview = await getImage({
  src: previewImg,
  width: 1200,
  format: "webp",
});
const optimizedEditor = await getImage({
  src: editorImg,
  width: 800,
  format: "webp",
});

import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/Navbar";
import { Hero } from "../components/Hero";
import { About } from "../components/About";
import { Projects } from "../components/Projects";
import { Articles } from "../components/Articles";
import { Contact } from "../components/Contact";
import { Footer } from "../components/Footer";
import { DecorativeCircle } from "../components/DecorativeCircle";
---

<Layout title="Sujal Jariwala | Software Engineer">
  <main class="min-h-screen relative overflow-hidden bg-bg-outer">
    {/* Global background circle */}
    <div
      class="absolute -top-125 -right-125 w-300 h-300 border border-circle rounded-full pointer-events-none z-0"
    >
    </div>
    <div
      class="absolute top-[20%] -left-150 w-250 h-250 border border-circle rounded-full pointer-events-none z-0"
    >
    </div>

    {/* Outer Intro Section */}
    <div class="max-w-7xl mx-auto px-6 py-24 relative z-10">
      <div
        class="flex flex-col md:flex-row justify-between items-start text-sm text-gray-light"
      >
        <div class="mb-8 md:mb-0">
          <p class="font-display tracking-wider">... /Status ...</p>
        </div>
        <div class="md:max-w-md">
          <p class="italic leading-relaxed">
            Open to new opportunities. Currently building <a
              href="https://resuvo.net"
              target="_blank"
              rel="noopener noreferrer"
              class="italic font-medium text-blue-600 underline decoration-blue-300 underline-offset-4 transition-colors hover:text-blue-700 hover:decoration-blue-600"
            >
              Resuvo
            </a>, an AI-powered resume builder, while exploring new technologies
            and ideas across the frontend ecosystem.
          </p>
        </div>
      </div>
    </div>

    {/* Main Portfolio Container */}
    <div class="max-w-300 mx-auto px-4 md:px-6 mb-32 relative z-10">
      <div
        class="bg-bg-inner border border-border-subtle rounded-4xl overflow-hidden shadow-2xl relative"
      >
        <DecorativeCircle size="800px" top="-400px" right="-200px" />
        <DecorativeCircle size="600px" bottom="10%" left="-300px" />
        <DecorativeCircle size="1000px" top="40%" right="-500px" />

        <Navbar client:load />
        <Hero client:load />
        <About portraitSrc={optimizedPortrait.src} />
        <Projects
          previewSrc={optimizedPreview.src}
          editorSrc={optimizedEditor.src}
        />
        <Articles />
        <Contact />
        <Footer />
      </div>
    </div>
  </main>
</Layout>
