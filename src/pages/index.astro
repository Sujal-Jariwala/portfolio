---
import { getImage } from "astro:assets";
import portraitImg from "../assets/portrait.jpeg";

const optimizedPortrait = await getImage({
  src: portraitImg,
  width: 800,
  format: "webp",
});

import previewImg from "../assets/resumetop_homepage.png";
import editorImg from "../assets/resumetop_editor.png";

const optimizedPreview = await getImage({
  src: previewImg,
  width: 1200,
  format: "webp",
});
const optimizedEditor = await getImage({
  src: editorImg,
  width: 800,
  format: "webp",
});

import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/Navbar";
import { Hero } from "../components/Hero";
import { About } from "../components/About";
import { Projects } from "../components/Projects";
import { Contact } from "../components/Contact";
import { Footer } from "../components/Footer";
import { Writings } from "../components/Writing";
import Stack from "../components/Stack";
import Reading from "../components/Reading";
import { getCollection } from "astro:content";

const writings = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((p) => ({ title: p.data.title, url: `/blog/${p.id}` }));
---

<Layout title="Sujal Jariwala | Software Engineer">
  <div class="flex justify-center">
    <main class="noise min-h-screen w-full max-w-3xl border-x border-line bg-panel transition-colors duration-[400ms]">
      <Navbar client:load />
      <Hero client:load />
      <About />
      <Stack client:visible />
      <Projects />
      <!-- <Articles /> -->
      <Writings posts={writings} />
      <Reading client:visible />
      <Contact />
      <Footer />
    </main>
  </div>
</Layout>
